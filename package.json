{
  "name": "@sarutobi-sasuke/obsidian-github-mcp",
  "version": "0.1.0",
  "author": "Alexei Udall",
  "homepage": "https://github.com/SarutobiSasuke8/obsidian-github-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarutobiSasuke8/obsidian-github-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SarutobiSasuke8/obsidian-github-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "obsidian",
    "github",
    "ai-agents",
    "access-control"
  ],
  "description": "A white-label, permissioned MCP gateway for agent-authored proposals to an Obsidian vault stored on GitHub.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "obsidian-github-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "config/policy.example.yaml",
    "config/tokens.example.yaml",
    "docs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "token:new": "node scripts/generate-token.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "minimatch": "10.2.6",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "eslint": "10.8.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
