{
  "name": "obsidian-github-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "obsidian",
    "github",
    "ai-agents",
    "access-control"
  ],
  "description": "A white-label, permissioned MCP gateway for agent-authored proposals to an Obsidian vault stored on GitHub.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "token:new": "node scripts/generate-token.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "minimatch": "10.2.6",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "eslint": "10.8.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
