VAULT_MCP_HOST=127.0.0.1
VAULT_MCP_PORT=3210
VAULT_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# VAULT_MCP_ALLOWED_ORIGINS=https://your-agent-host.example
VAULT_MCP_POLICY_FILE=./config/policy.yaml
VAULT_MCP_TOKEN_FILE=./config/tokens.yaml
VAULT_MCP_AUDIT_LOG=./var/audit.jsonl
VAULT_MCP_GITHUB_OWNER=your-github-user-or-org
VAULT_MCP_GITHUB_REPO=your-obsidian-vault-repository
VAULT_MCP_MAX_FILE_BYTES=262144
VAULT_MCP_ALLOWED_EXTENSIONS=.md,.txt,.json,.yaml,.yml,.csv,.base
VAULT_MCP_RATE_LIMIT=120
VAULT_MCP_RATE_WINDOW_MS=60000
VAULT_MCP_TRUST_PROXY_HOPS=0

# Recommended: a GitHub App installed only on the target vault repository.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=

# Local fallback: a repository-scoped fine-grained PAT with Contents: write.
# GITHUB_TOKEN=
